# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# サーバー専用（フォーム送信のCRM登録などに使用。RLSをバイパス）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 公開サイトの絶対URL（OGP・sitemap・robots・構造化データに使用）
NEXT_PUBLIC_SITE_URL=https://your-domain.example.com

# サイト設定（管理画面から変更予定の項目の初期値）
NEXT_PUBLIC_PHONE_NUMBER=0120-000-000
NEXT_PUBLIC_LINE_URL=https://line.me/R/ti/p/@your-line-id

# Google 計測タグ
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
